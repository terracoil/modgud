#!/usr/bin/env python3
"""
Shape Tools CLI - Refactored with individual shape commands
Focused CLI tool for shape generation with individual shape-specific subcommands.
"""
import json
import math
import sys
import tomllib
from enum import StrEnum, auto
from pathlib import Path
from typing import Any, Dict, Sequence

from modgud.api.geometry import Joinery, Line, SimplexNoise, StackableTrapezoid, TornPaper, Vector, VectorPath, VectorPort
from modgud.api.geometry.shapes import ShapeFactory, Square, Rectangle, Parallelogram, Rhombus, Trapezoid, Kite
from modgud.domain.enums import OrdinalEnum, QuadShapeEnum
from modgud.infrastructure.drawio_manager import DrawIOManager
from modgud.util import MathUtil

# Add the project root to the Python path
sys.path.insert(0, str(Path(__file__).parent.parent))

from freyja import FreyjaCLI


class FooBarEnum(StrEnum):
  bar = auto()
  baz = auto()
  foo = auto()


class ShapeTools:
  """Shape tools for geometry generation with individual shape commands."""

  def __init__(self, verbose: bool = False, dry_run: bool = False) -> None:
    """Initialize with optional verbose output and dry-run mode."""
    self.verbose: bool = verbose
    self.dry_run: bool = dry_run
    self.colors: Dict[str, str] = {
      'red': '\033[0;31m',
      'green': '\033[0;32m',
      'yellow': '\033[1;33m',
      'blue': '\033[0;34m',
      'nc': '\033[0m'  # No Color
    }

    self.project_src: str = self.get_project_src()
    self.project_name: str = self.get_project_name()
    self.drawio_manager = DrawIOManager()

  @classmethod
  def get_project_src(cls) -> str:
    """Get pyproject source root"""
    with open("pyproject.toml", "rb") as f:
      proj_map = tomllib.load(f)

      try:
        proj_root: str = proj_map["tool"]["poetry"]["packages"][0]["include"]
      except Exception as x:
        print(f"Error getting proj_root; falling back to project_name: {x}")
        proj_root: str = cls.get_project_name()

    return proj_root

  @classmethod
  def get_project_name(cls) -> str:
    """Get project name from pyproject.toml"""
    with open("pyproject.toml", "rb") as f:
      proj_map = tomllib.load(f)
      return proj_map["project"]["name"]

  def _create_shape(
    self,
    shape,
    shape_name: str,
    torn_sides: str,
    notch_sides: str,
    notch_size: float,
    notch_depth: float,
    notch_offset: float,
    segments: int,
    amplitude: float,
    noise_scale: float,
    octaves: int,
    seed: int,
    smoothing_factor: float,
    drawio: bool,
    drawio_output: str
  ) -> dict[str, Any]:
    """
    Common shape creation logic for all shape types.
    
    :param shape: Shape instance (Square, Rectangle, etc.)
    :param shape_name: Name for display purposes
    :param torn_sides: Comma-separated sides to tear
    :param notch_sides: Comma-separated sides to notch
    :param notch_size: Size of notch along edge axis (0.0-1.0)
    :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0)
    :param notch_offset: Offset from center position (-0.5 to 0.5)
    :param segments: Number of segments in torn edges
    :param amplitude: Amplitude of noise for torn edges
    :param noise_scale: Scale of noise
    :param octaves: Number of noise octaves
    :param seed: Random seed
    :param smoothing_factor: Smoothing factor
    :param drawio: Generate draw.io file
    :param drawio_output: Optional output directory for draw.io file
    """
    # Parse torn_sides string into OrdinalEnum list
    torn_sides_list = OrdinalEnum.parse_sides_string(torn_sides) if torn_sides else [OrdinalEnum.NONE]
    
    # Parse notch_sides string into OrdinalEnum list  
    notch_sides_list = OrdinalEnum.parse_sides_string(notch_sides) if notch_sides else [OrdinalEnum.NONE]
    
    # Create noise instance if torn sides specified
    noise = None
    if torn_sides_list and any(side != OrdinalEnum.NONE for side in torn_sides_list):
      noise = SimplexNoise(
        seed=seed,
        scale=noise_scale,
        octaves=octaves,
        persistence=0.5,
        lacunarity=2.0,
        amplitude=1.0
      )
    
    # Create shape with decoration parameters
    import inspect
    shape_constructor = type(shape).__init__
    constructor_params = inspect.signature(shape_constructor).parameters
    
    # Filter shape.__dict__ to only include constructor parameters (exclude 'self')
    filtered_dict = {k: v for k, v in shape.__dict__.items() if k in constructor_params and k != 'self'}
    
    # Update with decoration parameters
    filtered_dict.update({
      'torn_sides': torn_sides_list,
      'notch_sides': notch_sides_list,
      'notch_size': notch_size,
      'notch_depth': notch_depth,
      'notch_offset': notch_offset,
      'noise': noise,
      'noise_amplitude': amplitude,
      'noise_segments': segments,
      'smoothing_factor': smoothing_factor
    })
    decorated_shape = type(shape)(**filtered_dict)
    
    # Build the shape
    shape_vectors = decorated_shape.build_shape()
    
    # Scale back up to original coordinate system (from [0,1] to [0,100])
    scaled_vectors = []
    for v in shape_vectors:
      scaled_v = Vector(v.x * 100, v.y * 100, v.z, v.w, name=v.name)
      scaled_vectors.append(scaled_v)
    
    # Convert to legacy format using migrate_shape_result
    from modgud.api.geometry.svg import migrate_shape_result
    result = migrate_shape_result(scaled_vectors, 'shape')
    
    # Print formatted output
    svg_shape = result['shape']
    has_torn_sides = torn_sides_list and any(side != OrdinalEnum.NONE for side in torn_sides_list)
    has_notches = notch_sides_list and any(side != OrdinalEnum.NONE for side in notch_sides_list)
    
    # Build descriptive title
    title_parts = []
    if has_torn_sides:
      torn_str = ','.join(side.name for side in torn_sides_list if side != OrdinalEnum.NONE)
      title_parts.append(f"torn_sides={torn_str}")
      title_parts.append(f"amplitude={amplitude}")
      title_parts.append(f"seed={seed}")
    
    if has_notches:
      notch_str = ','.join(side.name for side in notch_sides_list if side != OrdinalEnum.NONE)
      title_parts.append(f"notch_sides={notch_str}")
      title_parts.append(f"notch_size={notch_size}")
      title_parts.append(f"notch_depth={notch_depth}")
      if notch_offset != 0.0:
        title_parts.append(f"notch_offset={notch_offset}")
    
    if title_parts:
      print(f"\n{shape_name} ({', '.join(title_parts)}):")
    else:
      print(f"\n{shape_name}:")
    
    # Add variant info for trapezoids
    if hasattr(decorated_shape, 'variant'):
      print(f"Variant: {decorated_shape.variant.value}")
    
    for line in svg_shape:
      print(line)
    
    # Handle draw.io output if requested
    if drawio:
      torn_str = ','.join(side.name for side in torn_sides_list if side != OrdinalEnum.NONE) if has_torn_sides else 'none'
      notch_str = ','.join(side.name for side in notch_sides_list if side != OrdinalEnum.NONE) if has_notches else 'none'
      
      draw_params = {
        'type': shape_name.lower(),
        'torn': torn_str,
        'notch': notch_str
      }
      
      # Add additional parameters if they have meaningful values
      if has_torn_sides:
        draw_params['amp'] = amplitude
        draw_params['seed'] = seed
      
      if has_notches:
        if notch_size != 0.1:  # Only include if different from default
          draw_params['nsize'] = notch_size
        if notch_depth != 0.0:  # Only include if different from default
          draw_params['ndepth'] = notch_depth
        if notch_offset != 0.0:  # Only include if different from default
          draw_params['noffset'] = notch_offset
      
      self._handle_drawio_output(scaled_vectors, f'{shape_name.lower()}', draw_params, drawio, drawio_output)
    
    return result

  def _handle_drawio_output(
    self,
    vectors: Sequence[VectorPort],
    shape_type: str,
    params: dict[str, Any],
    drawio: bool = False,
    drawio_output: str = '.'
  ) -> None:
    """
    Handle draw.io file generation if requested.

    :param vectors: Shape vectors to convert
    :param shape_type: Type of shape for filename
    :param params: Shape parameters for filename
    :param drawio: Whether to generate draw.io file
    :param drawio_output: Optional output directory
    """
    if drawio:
      # Generate filename
      filename = self.drawio_manager.generate_filename(shape_type, params)

      # Determine output path
      if drawio_output != '.':
        output_dir = Path(drawio_output)
        output_dir.mkdir(parents=True, exist_ok=True)
        filepath = output_dir / f"{filename}.drawio"
      else:
        filepath = Path(f"{filename}.drawio")

      # Create metadata
      metadata = {
        'name': shape_type.replace('_', ' ').title(),
        'shape_type': shape_type,
        'parameters': params
      }

      # Create draw.io file
      created_path = self.drawio_manager.create_drawio_file(vectors, filepath, metadata)

      # Print success message
      print(f"\n{self.colors['green']}✓ Created draw.io file:{self.colors['nc']} {created_path}")
      if self.verbose:
        print(f"  Shape: {shape_type}")
        print(f"  Parameters: {params}")
        print(f"  Vectors: {len(vectors)} points")

  def _create_shape(
    self,
    shape,
    shape_name: str,
    torn_sides: str,
    notch_sides: str,
    notch_size: float,
    notch_depth: float,
    notch_offset: float,
    segments: int,
    amplitude: float,
    noise_scale: float,
    octaves: int,
    seed: int,
    smoothing_factor: float,
    drawio: bool,
    drawio_output: str
  ) -> dict[str, Any]:
    """
    Common shape creation logic for all shape types.
    
    :param shape: Shape instance (Square, Rectangle, etc.)
    :param shape_name: Name for display purposes
    :param torn_sides: Comma-separated sides to tear
    :param notch_sides: Comma-separated sides to notch
    :param notch_size: Size of notch along edge axis (0.0-1.0)
    :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0)
    :param notch_offset: Offset from center position (-0.5 to 0.5)
    :param segments: Number of segments in torn edges
    :param amplitude: Amplitude of noise for torn edges
    :param noise_scale: Scale of noise
    :param octaves: Number of noise octaves
    :param seed: Random seed
    :param smoothing_factor: Smoothing factor
    :param drawio: Generate draw.io file
    :param drawio_output: Optional output directory for draw.io file
    """
    # Parse torn_sides string into OrdinalEnum list
    torn_sides_list = OrdinalEnum.parse_sides_string(torn_sides) if torn_sides else [OrdinalEnum.NONE]
    
    # Parse notch_sides string into OrdinalEnum list  
    notch_sides_list = OrdinalEnum.parse_sides_string(notch_sides) if notch_sides else [OrdinalEnum.NONE]
    
    # Create noise instance if torn sides specified
    noise = None
    if torn_sides_list and any(side != OrdinalEnum.NONE for side in torn_sides_list):
      noise = SimplexNoise(
        seed=seed,
        scale=noise_scale,
        octaves=octaves,
        persistence=0.5,
        lacunarity=2.0,
        amplitude=1.0
      )
    
    # Create shape with decoration parameters
    import inspect
    shape_constructor = type(shape).__init__
    constructor_params = inspect.signature(shape_constructor).parameters
    
    # Filter shape.__dict__ to only include constructor parameters (exclude 'self')
    filtered_dict = {k: v for k, v in shape.__dict__.items() if k in constructor_params and k != 'self'}
    
    # Update with decoration parameters
    filtered_dict.update({
      'torn_sides': torn_sides_list,
      'notch_sides': notch_sides_list,
      'notch_size': notch_size,
      'notch_depth': notch_depth,
      'notch_offset': notch_offset,
      'noise': noise,
      'noise_amplitude': amplitude,
      'noise_segments': segments,
      'smoothing_factor': smoothing_factor
    })
    decorated_shape = type(shape)(**filtered_dict)
    
    # Build the shape
    shape_vectors = decorated_shape.build_shape()
    
    # Scale back up to original coordinate system (from [0,1] to [0,100])
    scaled_vectors = []
    for v in shape_vectors:
      scaled_v = Vector(v.x * 100, v.y * 100, v.z, v.w, name=v.name)
      scaled_vectors.append(scaled_v)
    
    # Convert to legacy format using migrate_shape_result
    from modgud.api.geometry.svg import migrate_shape_result
    result = migrate_shape_result(scaled_vectors, 'shape')
    
    # Print formatted output
    svg_shape = result['shape']
    has_torn_sides = torn_sides_list and any(side != OrdinalEnum.NONE for side in torn_sides_list)
    has_notches = notch_sides_list and any(side != OrdinalEnum.NONE for side in notch_sides_list)
    
    # Build descriptive title
    title_parts = []
    if has_torn_sides:
      torn_str = ','.join(side.name for side in torn_sides_list if side != OrdinalEnum.NONE)
      title_parts.append(f"torn_sides={torn_str}")
      title_parts.append(f"amplitude={amplitude}")
      title_parts.append(f"seed={seed}")
    
    if has_notches:
      notch_str = ','.join(side.name for side in notch_sides_list if side != OrdinalEnum.NONE)
      title_parts.append(f"notch_sides={notch_str}")
      title_parts.append(f"notch_size={notch_size}")
      title_parts.append(f"notch_depth={notch_depth}")
      if notch_offset != 0.0:
        title_parts.append(f"notch_offset={notch_offset}")
    
    if title_parts:
      print(f"\n{shape_name} ({', '.join(title_parts)}):")
    else:
      print(f"\n{shape_name}:")
    
    # Add variant info for trapezoids
    if hasattr(decorated_shape, 'variant'):
      print(f"Variant: {decorated_shape.variant.value}")
    
    for line in svg_shape:
      print(line)
    
    # Handle draw.io output if requested
    if drawio:
      torn_str = ','.join(side.name for side in torn_sides_list if side != OrdinalEnum.NONE) if has_torn_sides else 'none'
      notch_str = ','.join(side.name for side in notch_sides_list if side != OrdinalEnum.NONE) if has_notches else 'none'
      
      draw_params = {
        'type': shape_name.lower(),
        'torn': torn_str,
        'notch': notch_str
      }
      
      # Add additional parameters if they have meaningful values
      if has_torn_sides:
        draw_params['amp'] = amplitude
        draw_params['seed'] = seed
      
      if has_notches:
        if notch_size != 0.1:  # Only include if different from default
          draw_params['nsize'] = notch_size
        if notch_depth != 0.0:  # Only include if different from default
          draw_params['ndepth'] = notch_depth
        if notch_offset != 0.0:  # Only include if different from default
          draw_params['noffset'] = notch_offset
      
      self._handle_drawio_output(scaled_vectors, f'{shape_name.lower()}', draw_params, drawio, drawio_output)
    
    return result

  class Joinery:
    """Joinery operations for calculating joint coordinates."""
    def __init__(self, parent) -> None:
      """Initialize with parent ShapeTools instance."""
      self.parent: 'ShapeTools' = parent

    def dovetail(self, teeth_slope_pct: float = 0.1, teeth_cnt: int = 2, tooth_depth_pct: float = 0.35,
                 corner_pct: float = 0.1, drawio: bool = False, drawio_output: str = '.') -> dict[str, Any]:
      """
      Calculate the coordinates of dovetail joint points.

      Uses the Joinery class for all calculations.

      :param teeth_slope_pct: Slope percentage for teeth
      :param teeth_cnt: Number of teeth
      :param tooth_depth_pct: Depth percentage for teeth
      :param corner_pct: Corner percentage
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      # Create joinery instance and calculate dovetail
      joinery = Joinery(
        slope_pct=teeth_slope_pct,
        teeth_cnt=teeth_cnt,
        tooth_depth_pct=tooth_depth_pct,
        corner_pct=corner_pct
      )

      shapeResult = joinery.build_all_shapes()  # Use backward compatibility method

      # Print formatted output
      svg_left = shapeResult['left']
      svg_right = shapeResult['right']
      svg_teeth = shapeResult['teeth']

      for k,v in shapeResult.items():
        print(f"\n{k}: {'\n'.join(v)}\n\n")

      max_len = max(len(svg_left), len(svg_right), len(svg_teeth))
      print(f"{'Left':<40}{'Right':<40}{'Teeth':<40}")
      for i in range(max_len):
        lft: str = svg_left[i] if i < len(svg_left) else ''
        rgt: str = svg_right[i] if i < len(svg_right) else ''
        tth: str = svg_teeth[i] if i < len(svg_teeth) else ''
        print(f"{lft:<40}{rgt:<40}{tth:<40}")

      # Handle draw.io output if requested
      if drawio:
        # Get the adapter shape vectors (left/adapter shape)
        adapter_vectors = joinery.build_adapter_shape()
        params = {
          'slopepct': teeth_slope_pct,
          'teethcnt': teeth_cnt,
          'depthpct': tooth_depth_pct
        }
        self.parent._handle_drawio_output(adapter_vectors, 'dovetail', params, drawio, drawio_output)

      return shapeResult

  class Shape:
    def __init__(self, parent) -> None:
        """Initialize with parent ShapeTools instance and common parameters."""
        self.parent: 'ShapeTools' = parent
        # Common parameters with defaults - these could be made configurable in the future
        self.segments = 100
        self.amplitude = 5.0
        self.noise_scale = 0.1
        self.octaves = 3
        self.seed = 42
        self.smoothing_factor = 0.1
        self.drawio = False
        self.drawio_output = '.'

    def stackable_trapezoid(self, h2: float = 0.272, notch_height: float = 0.2, width: float = 100, height: float = 100,
                            invert: bool = False, drawio: bool = False, drawio_output: str = '.') -> dict[str, Any]:
      """
      Generate a stackable trapezoid using the proper geometry module.

      :param h2: Ratio of top edge to bottom edge width (0.2 to 0.85)
      :param notch_height: Height of stacking notch as percentage
      :param width: Width of trapezoid
      :param height: Height of trapezoid
      :param invert: Whether to invert the trapezoid
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      trapezoid = StackableTrapezoid(
        h2=h2,
        notch_height=notch_height,
        width=width,
        height=height,
        invert=invert
      )

      # Convert to legacy format using migrate_shape_result
      from modgud.api.geometry.svg import migrate_shape_result
      trap_vectors = trapezoid.build_shape()
      trap_path:dict[str, list[str]] = migrate_shape_result(trap_vectors, 'shape')

      # Print formatted output
      svg_shape = trap_path['shape']
      print(f"\nStackable Trapezoid (h2={h2:.3f}, stackable_pct={notch_height}):")
      for line in svg_shape:
        print(line)

      # Handle draw.io output if requested
      if drawio:
        params = {
          'h2': h2,
          'notch': notch_height,
          'invert': invert
        }
        self.parent._handle_drawio_output(trap_vectors, 'stackable_trapezoid', params, drawio, drawio_output)

      return trap_path

    def square(
      self,
      side: float = 100,
      torn_sides: str = '',
      notch_sides: str = '',
      notch_size: float = 0.1,
      notch_depth: float = 0.0,
      notch_offset: float = 0.0
    ) -> dict[str, Any]:
      """
      Generate a square with optional torn edges and/or notches.
      
      :param side: Length of each side
      :param torn_sides: Comma-separated sides to tear (e.g., "NORTH,SOUTH" or "N,S")
      :param notch_sides: Comma-separated sides to notch (e.g., "N,S" or "NE,SW")
      :param notch_size: Size of notch along edge axis (0.0-1.0)
      :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0) 
      :param notch_offset: Offset from center position (-0.5 to 0.5)
      """
      return self.parent._create_shape(
        Square(side=side/100),
        'Square',
        torn_sides, notch_sides, notch_size, notch_depth, notch_offset,
        self.segments, self.amplitude, self.noise_scale, self.octaves, self.seed, self.smoothing_factor,
        self.drawio, self.drawio_output
      )

    def rectangle(
      self,
      width: float = 100,
      height: float = 100,
      torn_sides: str = '',
      notch_sides: str = '',
      notch_size: float = 0.1,
      notch_depth: float = 0.0,
      notch_offset: float = 0.0
    ) -> dict[str, Any]:
      """
      Generate a rectangle with optional torn edges and/or notches.
      
      :param width: Width of rectangle
      :param height: Height of rectangle
      :param torn_sides: Comma-separated sides to tear (e.g., "NORTH,SOUTH" or "N,S")
      :param notch_sides: Comma-separated sides to notch (e.g., "N,S" or "NE,SW")
      :param notch_size: Size of notch along edge axis (0.0-1.0)
      :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0)
      :param notch_offset: Offset from center position (-0.5 to 0.5)
      :param segments: Number of segments in torn edges
      :param amplitude: Amplitude of noise for torn edges
      :param noise_scale: Scale of noise
      :param octaves: Number of noise octaves
      :param seed: Random seed
      :param smoothing_factor: Smoothing factor
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      return self.parent._create_shape(
        Rectangle(width=width/100, height=height/100),
        'Rectangle',
        torn_sides, notch_sides, notch_size, notch_depth, notch_offset,
        self.segments, self.amplitude, self.noise_scale, self.octaves, self.seed, self.smoothing_factor,
        self.drawio, self.drawio_output
      )

    def parallelogram(
      self,
      width: float = 100,
      height: float = 100,
      angle: float = 60.0,
      slant: float = -1.0,
      torn_sides: str = '',
      notch_sides: str = '',
      notch_size: float = 0.1,
      notch_depth: float = 0.0,
      notch_offset: float = 0.0,
    ) -> dict[str, Any]:
      """
      Generate a parallelogram with optional torn edges and/or notches.
      
      :param width: Base width
      :param height: Perpendicular height  
      :param angle: Interior angle in degrees (default 60.0)
      :param slant: Optional horizontal offset instead of angle
      :param torn_sides: Comma-separated sides to tear (e.g., "NORTH,SOUTH" or "N,S")
      :param notch_sides: Comma-separated sides to notch (e.g., "N,S" or "NE,SW")
      :param notch_size: Size of notch along edge axis (0.0-1.0)
      :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0)
      :param notch_offset: Offset from center position (-0.5 to 0.5)
      :param segments: Number of segments in torn edges
      :param amplitude: Amplitude of noise for torn edges
      :param noise_scale: Scale of noise
      :param octaves: Number of noise octaves
      :param seed: Random seed
      :param smoothing_factor: Smoothing factor
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      # Convert angle to radians
      angle_rad = math.radians(angle)
      
      return self.parent._create_shape(
        Parallelogram(width=width/100, height=height/100, angle=angle_rad, slant=slant/100 if slant >= 0 else None),
        'Parallelogram',
        torn_sides, notch_sides, notch_size, notch_depth, notch_offset,
        self.segments, self.amplitude, self.noise_scale, self.octaves, self.seed, self.smoothing_factor,
        self.drawio, self.drawio_output
      )

    def rhombus(
      self,
      side: float = 100,
      angle: float = 60.0,
      torn_sides: str = '',
      notch_sides: str = '',
      notch_size: float = 0.1,
      notch_depth: float = 0.0,
      notch_offset: float = 0.0,
    ) -> dict[str, Any]:
      """
      Generate a rhombus with optional torn edges and/or notches.
      
      :param side: Length of all sides
      :param angle: Interior angle in degrees
      :param torn_sides: Comma-separated sides to tear (e.g., "NORTH,SOUTH" or "N,S")
      :param notch_sides: Comma-separated sides to notch (e.g., "N,S" or "NE,SW")
      :param notch_size: Size of notch along edge axis (0.0-1.0)
      :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0)
      :param notch_offset: Offset from center position (-0.5 to 0.5)
      :param segments: Number of segments in torn edges
      :param amplitude: Amplitude of noise for torn edges
      :param noise_scale: Scale of noise
      :param octaves: Number of noise octaves
      :param seed: Random seed
      :param smoothing_factor: Smoothing factor
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      # Convert angle to radians
      angle_rad = math.radians(angle)
      
      return self.parent._create_shape(
        Rhombus(side=side/100, angle=angle_rad),
        'Rhombus',
        torn_sides, notch_sides, notch_size, notch_depth, notch_offset,
        self.segments, self.amplitude, self.noise_scale, self.octaves, self.seed, self.smoothing_factor,
        self.drawio, self.drawio_output
      )

    def trapezoid(
      self,
      w1: float = 100,
      w2: float = 60,
      h: float = 80,
      side_left: float | None = None,
      torn_sides: str = '',
      notch_sides: str = '',
      notch_size: float = 0.1,
      notch_depth: float = 0.0,
      notch_offset: float = 0.0,
    ) -> dict[str, Any]:
      """
      Generate a trapezoid with automatic variant detection and optional torn edges/notches.
      
      Variant is automatically determined from parameters:
      - ISOSCELES: side_left not specified (symmetric)
      - RIGHT_ANGLE: side_left == h (90-degree left angle) 
      - GENERAL: side_left specified and != h (asymmetric)
      
      :param w1: Bottom width (base)
      :param w2: Top width
      :param h: Height
      :param side_left: Optional left side length constraint
      :param torn_sides: Comma-separated sides to tear (e.g., "NORTH,SOUTH" or "N,S")
      :param notch_sides: Comma-separated sides to notch (e.g., "N,S" or "NE,SW") 
      :param notch_size: Size of notch along edge axis (0.0-1.0)
      :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0)
      :param notch_offset: Offset from center position (-0.5 to 0.5)
      :param segments: Number of segments in torn edges
      :param amplitude: Amplitude of noise for torn edges
      :param noise_scale: Scale of noise
      :param octaves: Number of noise octaves
      :param seed: Random seed
      :param smoothing_factor: Smoothing factor
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      return self.parent._create_shape(
        Trapezoid(w1=w1/100, w2=w2/100, h=h/100, side_left=side_left/100 if side_left else None),
        'Trapezoid',
        torn_sides, notch_sides, notch_size, notch_depth, notch_offset,
        self.segments, self.amplitude, self.noise_scale, self.octaves, self.seed, self.smoothing_factor,
        self.drawio, self.drawio_output
      )

    def kite(
      self,
      diagonal1: float = 100,
      diagonal2: float = 80,
      torn_sides: str = '',
      notch_sides: str = '',
      notch_size: float = 0.1,
      notch_depth: float = 0.0,
      notch_offset: float = 0.0,
    ) -> dict[str, Any]:
      """
      Generate a kite with optional torn edges and/or notches.
      
      :param diagonal1: First diagonal length (vertical)
      :param diagonal2: Second diagonal length (horizontal)
      :param torn_sides: Comma-separated sides to tear (e.g., "NORTH,SOUTH" or "N,S")
      :param notch_sides: Comma-separated sides to notch (e.g., "N,S" or "NE,SW")
      :param notch_size: Size of notch along edge axis (0.0-1.0)
      :param notch_depth: Depth of notch perpendicular to edge (0.0-1.0)
      :param notch_offset: Offset from center position (-0.5 to 0.5)
      :param segments: Number of segments in torn edges
      :param amplitude: Amplitude of noise for torn edges
      :param noise_scale: Scale of noise
      :param octaves: Number of noise octaves
      :param seed: Random seed
      :param smoothing_factor: Smoothing factor
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      return self.parent._create_shape(
        Kite(diagonal1=diagonal1/100, diagonal2=diagonal2/100),
        'Kite',
        torn_sides, notch_sides, notch_size, notch_depth, notch_offset,
        self.segments, self.amplitude, self.noise_scale, self.octaves, self.seed, self.smoothing_factor,
        self.drawio, self.drawio_output
      )

    def torn_box(
      self,
      width: float = 100,
      height: float = 100,
      torn_sides: str = 'NS',
      drawio: bool = False,
      drawio_output: str = '.'
    ) -> dict[str, Any]:
      """
      Generate a torn paper box with specified torn edges.

      :param width: Width of the box
      :param height: Height of the box
      :param torn_sides: Which sides to make torn (N/S/E/W combinations)
      :param segments: Number of segments in torn edges
      :param amplitude: Amplitude of noise for torn edges
      :param noise_scale: Scale of noise
      :param octaves: Number of noise octaves
      :param seed: Random seed
      :param smoothing_factor: Smoothing factor
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      # Create noise instance
      noise = SimplexNoise(
        seed=self.seed,
        scale=self.noise_scale,
        octaves=self.octaves,
        persistence=0.5,
        lacunarity=2.0,
        amplitude=1.0
      )

      # Create torn paper box
      torn_paper = TornPaper(
        noise=noise,
        torn_sides=torn_sides,
        segments=self.segments,
        amplitude=self.amplitude,
        width=width,
        height=height,
        smoothing_factor=self.smoothing_factor
      )

      # Build the shape
      torn_vectors = torn_paper.build_shape()

      # Convert to legacy format using migrate_shape_result
      from modgud.api.geometry.svg import migrate_shape_result
      result = migrate_shape_result(torn_vectors, 'shape')

      # Print formatted output
      svg_shape = result['shape']
      print(f"\nTorn Paper Box (sides={torn_sides}, amplitude={self.amplitude}, seed={self.seed}):")
      for line in svg_shape:
        print(line)

      # Handle draw.io output if requested
      if drawio:
        params = {
          'sides': torn_sides,
          'amp': self.amplitude,
          'seed': self.seed,
          # 'seg': self.segments,  # Excluded to ensure 'sides' is in top 3
        }
        self.parent._handle_drawio_output(torn_vectors, 'torn_box', params, drawio, drawio_output)

      return result

    def noisy_line(
      self,
      start_x: float = 0,
      start_y: float = 0,
      end_x: float = 100,
      end_y: float = 50,
      segments: int = 50,
      amplitude: float = 5.0,
      noise_scale: float = 0.1,
      octaves: int = 3,
      seed: int = 42,
      smoothing_factor: float = 0.1,
      drawio: bool = False,
      drawio_output: str = '.'
    ) -> dict[str, Any]:
      """
      Generate a noisy line with specified parameters.

      :param start_x: Starting X coordinate
      :param start_y: Starting Y coordinate
      :param end_x: Ending X coordinate
      :param end_y: Ending Y coordinate
      :param segments: Number of line segments
      :param amplitude: Noise amplitude
      :param noise_scale: Noise scale
      :param octaves: Number of octaves
      :param seed: Random seed
      :param smoothing_factor: Smoothing factor
      :param drawio: Generate draw.io file
      :param drawio_output: Optional output directory for draw.io file
      """
      # Create start and end vectors
      start = Vector(start_x, start_y, name='start')
      end = Vector(end_x, end_y, name='end')

      # Create noise instance
      noise = SimplexNoise(
        seed=seed,
        scale=noise_scale,
        octaves=octaves,
        persistence=0.5,
        lacunarity=2.0,
        amplitude=amplitude
      )

      # Create line with noise
      line = Line(
        start=start,
        stop=end,
        noise=noise,
        noise_segments=segments,
        smoothing_factor=smoothing_factor
      )

      # Build the shape and convert to VectorPath for SVG output
      line_points = line.build_shape()

      # Create VectorPath from points
      path = VectorPath(name='noisyLine', abs_segments=line_points, close=False)
      svg_output = list(path.svg_path())

      result = {'shape': svg_output}

      # Print formatted output
      print(f"\nNoisy Line (start=({start_x}, {start_y}), end=({end_x}, {end_y}), amplitude={amplitude}, seed={seed}):")
      for line_svg in svg_output:
        print(line_svg)

      # Handle draw.io output if requested
      if drawio:
        params = {
          'amp': amplitude,
          'seg': segments,
          'seed': seed
        }
        self.parent._handle_drawio_output(line_points, 'noisy_line', params, drawio, drawio_output)

      return result


if __name__ == '__main__':
  # Create the CLI instance for Shape Tools
  cli = FreyjaCLI(ShapeTools, title=f"{ShapeTools.get_project_name().capitalize()} Shape Tools")
  result = cli.run()
  sys.exit(result if isinstance(result, int) else 0)