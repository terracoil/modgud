<shape name="slantTeethLeft" h="100" w="100" aspect="variable" strokewidth="inherit">
    <background>
        <connections>
            <constraint x="0" y="0" perimeter="1"/>
            <constraint x="0.5" y="0" perimeter="1"/>
            <constraint x="1" y="0" perimeter="1"/>
            <constraint x="0" y="0.5" perimeter="1"/>
            <constraint x="1" y="0.5" perimeter="1"/>
            <constraint x="0" y="1" perimeter="1"/>
            <constraint x="0.5" y="1" perimeter="1"/>
            <constraint x="1" y="1" perimeter="1"/>
        </connections>

        <path name="notchedPort">
            <!-- begStub -->
            <move x="100.0" y="0.0"/>
            <!-- slot-2-side-b -->
            <line x="87.5" y="0.0"/>
            <!-- slot-2-end -->
            <line x="87.5" y="35.0"/>
            <!-- slot-2-side-a -->
            <line x="62.5" y="35.0"/>
            <!-- slot-1-gap -->
            <line x="62.5" y="0.0"/>
            <!-- slot-1-side-b -->
            <line x="37.5" y="0.0"/>
            <!-- slot-1-end -->
            <line x="37.5" y="35.0"/>
            <!-- slot-1-side-a -->
            <line x="12.5" y="35.0"/>
            <!-- endStub -->
            <line x="12.5" y="0.0"/>
            <!-- origin -->
            <line x="0.0" y="0.0"/>
            <!-- portEnclosureTop -->
            <line x="0.0" y="100.0"/>
            <!-- portEnclosureRight -->
            <line x="90.0" y="100.0"/>
            <!-- portEnclosureCorner -->
            <line x="100.0" y="80.0"/>
            <close/>
        </path>
        <fillstroke/>
    </background>
</shape>
